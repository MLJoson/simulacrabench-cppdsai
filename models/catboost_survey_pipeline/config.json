{
  "datasets": {
    "unhcr": {
      "parquet": "data/unhcr_respondents.parquet",
      "schema": "schemas/unhcr_schema.json"
    },
    "unicef": {
      "parquet": "data/unicef_respondents.parquet",
      "schema": "schemas/unicef_schema.json"
    },
    "world_bank": {
      "parquet": "data/world_bank_respondents.parquet",
      "schema": "schemas/world_bank_schema.json"
    }
  },
  "output_dir": "artifacts",
  "random_seed": 42,
  "catboost": {
    "iterations": 1000,
    "depth": 6,
    "learning_rate": 0.05,
    "l2_leaf_reg": 5,
    "early_stopping_rounds": 100,
    "auto_class_weights": "Balanced",
    "verbose": false
  }
}